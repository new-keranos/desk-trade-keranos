# Which AI runs Nova: "gemini" (default, free tier) or "claude"
AI_PROVIDER=gemini

# Gemini API key from https://aistudio.google.com/apikey (free tier works)
GEMINI_API_KEY=
# Optional, defaults to gemini-flash-latest
GEMINI_MODEL=

# Only needed when AI_PROVIDER=claude. Key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Password that protects the whole app (you log in once per browser)
APP_PASSWORD=
# Long random string that encrypts the TradingView login cookie (falls back to APP_PASSWORD)
SESSION_SECRET=

# Optional: the app's public URL, e.g. https://nova-desk.vercel.app (used for the TradingView login redirect)
APP_URL=
# Optional: defaults to TradingView's official server https://mcp.tradingview.com/mcp
TRADINGVIEW_MCP_URL=
