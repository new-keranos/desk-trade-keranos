# Anthropic API key from https://console.anthropic.com (server only, never exposed to the browser)
ANTHROPIC_API_KEY=

# Remote TradingView MCP server (Streamable HTTP endpoint) and its bearer token
TRADINGVIEW_MCP_URL=
TRADINGVIEW_MCP_TOKEN=

# Password that protects the whole app (you log in once per browser)
APP_PASSWORD=
