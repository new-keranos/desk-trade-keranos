# Default AI for Nova and the scanner: "gemini" (default, free tier), "openai" or "claude".
# Every provider with a key below also shows up in the in-app model picker.
AI_PROVIDER=gemini

# Gemini API key from https://aistudio.google.com/apikey (free tier works)
GEMINI_API_KEY=
# Optional, defaults to gemini-flash-latest
GEMINI_MODEL=

# Optional: OpenAI key from https://platform.openai.com (billed per token). OPENAI_MODEL defaults to gpt-5.4-mini
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional: Claude key from https://console.anthropic.com (billed per token). CLAUDE_MODEL defaults to claude-opus-5-5
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# Password that protects the whole app (you log in once per browser)
APP_PASSWORD=
# Long random string that encrypts the TradingView login cookie (falls back to APP_PASSWORD)
SESSION_SECRET=

# Optional: the app's public URL, e.g. https://nova-desk.vercel.app (used for the TradingView login redirect)
APP_URL=
# Optional: defaults to TradingView's official server https://mcp.tradingview.com/mcp
TRADINGVIEW_MCP_URL=
